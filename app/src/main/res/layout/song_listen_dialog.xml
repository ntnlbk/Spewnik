<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/listen_dialog_style">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/listen_dialog_style"
        android:backgroundTint="@color/C16"
        android:backgroundTintMode="src_in"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/close_dialog_btn"
            android:layout_width="20dp"
            android:layout_height="17.25dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8.13dp"
            android:contentDescription="@string/close_dialog_button"
            app:srcCompat="@drawable/down_arrow_icon" />

        <TextView
            android:id="@+id/song_name_dialog_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.13dp"
            android:fontFamily="@font/myfont"
            android:gravity="center"
            tools:text="Паўлінка"
            android:textColor="@color/C2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/song_seekbar"
            android:layout_width="280dp"
            android:layout_height="25dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progressBackgroundTint="@color/C18"
            android:progressBackgroundTintMode="add"
            android:progressTint="@color/C17"
            android:thumb="@drawable/eclipse" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/actual_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="78dp"
                    android:fontFamily="@font/myfont"
                    tools:text="0:00"
                    android:textColor="@color/C19" />

                <TextView
                    android:id="@+id/song_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="78dp"
                    android:fontFamily="@font/myfont"
                    tools:text="0:00"
                    android:textColor="@color/C19"/>
            </RelativeLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/play_btn"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12.31dp"
            android:layout_marginBottom="29.92dp"
            android:contentDescription="@string/play_button_content_description"
            app:srcCompat="@drawable/play_button_icon" />

    </LinearLayout>

</RelativeLayout>